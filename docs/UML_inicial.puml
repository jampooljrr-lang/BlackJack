@startuml UML_inicial
title UML inicial - 21 Black Jack (diseño de partida, según el enunciado)
skinparam classAttributeIconSize 0

package "Modelo" {
  class Carta {
    -String valor
    -String palo
    +getValor(): String
    +getPalo(): String
  }
  class Mazo {
    -Carta[] cartas   // arreglo de 52 posiciones
    -int siguienteCarta
    +crearMazo()
    +barajar()
    +repartirCarta(): Carta
  }
  class Mano {
    -LinkedList<Carta> cartas   // lista enlazada
    +agregarCarta(Carta)
    +calcularPuntos(): int
    +getCantidadCartas(): int
    +getCarta(int): Carta
  }
  class BlackJackGame {
    -Mazo mazo
    -Mano manoJugador
    -Mano manoComputador
    -int saldo
    -int apuesta
    -boolean rondaActiva
    +realizarApuesta(int): boolean
    +iniciarRonda()
    +pedirCarta()
    +plantarse()
    +getPuntosJugador(): int
    +getPuntosComputador(): int
    +getSaldo(): int
  }
}

package "Vista" {
  class GameView <<FXML>>
}
package "Controlador" {
  class GameController {
    +onIniciarRonda()
    +onPedirCarta()
    +onPlantarse()
  }
}

Mazo "1" *-- "52" Carta : contiene
Mano "1" o-- "0..*" Carta : contiene
BlackJackGame "1" *-- "1" Mazo
BlackJackGame "1" *-- "2" Mano : jugador y computador
GameController --> BlackJackGame : solicita operaciones
GameController ..> GameView : actualiza
@enduml
