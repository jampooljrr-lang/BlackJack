@startuml UML_final_BlackJack
title UML final - 21 Black Jack
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "com.example.blackjack.model" {
  class Carta {
    - valor: String
    - palo: String
    + Carta(valor: String, palo: String)
    + getValor(): String
    + getPalo(): String
  }
  class Mano {
    - cartas: LinkedList<Carta>
    + agregarCarta(carta: Carta): void
    + calcularPuntos(): int
    + getCantidadCartas(): int
    + getCarta(posicion: int): Carta
  }
  class Mazo {
    - cartas: Carta[52]
    - siguienteCarta: int
    + Mazo()
    + crearMazo(): void
    + barajar(): void
    + repartirCarta(): Carta
  }
  class BlackJackGame {
    - mazo: Mazo
    - manoJugador: Mano
    - manoComputador: Mano
    - saldo: int
    - apuesta: int
    - rondaActiva: boolean
    - turnoComputador: boolean
    - resultado: String
    + iniciarRonda(): void
    + realizarApuesta(cantidad: int): boolean
    + pedirCarta(): void
    + plantarse(): void
    + validarApuesta(texto: String): String
    + tieneVeinteYMedio(mano: Mano): boolean
    + getPuntosJugador(): int
    + getPuntosComputador(): int
    + getSaldo(): int
  }
  class PruebaBlackJack <<test manual>>
}

package "com.example.blackjack.controller" {
  class MenuController <<controller>>
  class GameController <<controller>>
  class Dialogos <<utility>>
}

package "com.example.blackjack.view" {
  class MenuView <<FXML>>
  class GameView <<FXML>>
  class MenuCSS <<CSS>>
  class JuegoCSS <<CSS>>
}

Mazo "1" *-- "52" Carta : contiene
Mano "1" *-- "0..*" Carta : contiene
BlackJackGame "1" *-- "1" Mazo
BlackJackGame "1" *-- "1" Mano : jugador
BlackJackGame "1" *-- "1" Mano : computador
GameController "1" --> "1" BlackJackGame : utiliza
GameController ..> GameView : actualiza
MenuController ..> MenuView : carga
MenuController ..> GameView : carga
MenuController ..> Dialogos : utiliza
GameController ..> Dialogos : utiliza
MenuView ..> MenuCSS : usa
GameView ..> JuegoCSS : usa
PruebaBlackJack ..> BlackJackGame : verifica
@enduml
