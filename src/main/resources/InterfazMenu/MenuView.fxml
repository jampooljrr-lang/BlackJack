<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>


<BorderPane minHeight="480.0" minWidth="900.0" prefHeight="505.0" prefWidth="960.0" styleClass="menu-root" stylesheets="@menu.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.blackjack.controller.MenuController">


   <!-- Titulo, subtitulo y boton JUGAR -->
   <center>
      <VBox alignment="TOP_CENTER" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="80.0" />
         </padding>
         <children>
            <Text fx:id="txtTitulo" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="menu-titulo" text="BLACKJACK 21" />
            <StackPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="menu-halo">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
               <children>
                  <Button fx:id="btnJugar" mnemonicParsing="false" onAction="#onJugar" styleClass="menu-boton-jugar" text="JUGAR" />
               </children>
            </StackPane>
         </children>
      </VBox>
   </center>

   <!-- Botones inferiores derecha -->
   <bottom>
      <HBox alignment="BOTTOM_RIGHT" spacing="16.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="24.0" right="24.0" />
         </padding>
         <children>
            <Button fx:id="btnVerReglas" mnemonicParsing="false" onAction="#onVerReglas" styleClass="menu-boton-reglas" text="VER REGLAS" />
            <Button fx:id="btnCerrarJuego" mnemonicParsing="false" onAction="#onCerrarJuego" styleClass="menu-boton-cerrar" text="CERRAR JUEGO" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
